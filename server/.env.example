# ==========================================
# SERVER
# ==========================================
NODE_ENV=development
PORT=5000

# ==========================================
# DATABASE
# ==========================================
MONGODB_URI=mongodb://localhost:27017/careeros

# ==========================================
# JWT
# ==========================================
JWT_SECRET=your_super_long_random_secret
# ==========================================
# CLIENT & SECURITY
# ==========================================
ALLOWED_ORIGINS=http://localhost:3000
ALLOW_DEMO_MODE=false # Demo authentication is development-only and must be explicitly enabled.
GITHUB_WEBHOOK_SECRET=

# ==========================================
# CLOUDINARY (Resume/Profile Uploads)
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# OPENAI
# ==========================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# GEMINI
# ==========================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional AI providers
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPEN_AI_API_KEY=

# ==========================================
# JOB INTELLIGENCE PROVIDERS
# ==========================================
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

JOB_PROVIDER_ADZUNA_ENABLED=true
JOB_PROVIDER_GREENHOUSE_ENABLED=true
JOB_PROVIDER_LEVER_ENABLED=true
JOB_PROVIDER_ASHBY_ENABLED=true
JOB_PROVIDER_INDIANAPI_ENABLED=false
JOB_PROVIDER_JOBVETTA_ENABLED=false
JOB_PROVIDER_JOOBLE_ENABLED=false
INDIANAPI_API_KEY=
JOBVETTA_API_KEY=
JOOBLE_API_KEY=
